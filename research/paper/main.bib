	title = {Evaluating and deploying {Large} {Vision}-{Language} {Models} for fruit quality assessment in smart agriculture systems},
	volume = {238},
	issn = {0168-1699},
	url = {https://www.sciencedirect.com/science/article/pii/S0168169925009123},
	doi = {10.1016/j.compag.2025.110806},
	abstract = {The integration of Large Vision-Language Models (LVLMs) into Agricultural Cybernetics holds transformative potential for intelligent farming systems, yet their efficacy in critical tasks like fruit quality assessment remains underexplored. Although LVLMs have demonstrated remarkable capabilities in generic visual-language tasks, their application to agricultural scenarios—particularly those requiring nuanced, multi-dimensional analysis of perishable goods—faces significant challenges due to the absence of domain-specific benchmarks. To address this gap, we present FruitMMBench, a comprehensive multi-modal benchmark tailored for fruit quality assessment, comprising 5,465 meticulously annotated fruit images with multi-aspect labels, including classification, quantity, maturity, surface condition, quality status, and edibility. A novel metric is proposed to holistically assess model performance in these dimensions. Through systematic evaluation of leading LVLMs, we reveal their limitations in real-world agricultural contexts: existing models exhibit inconsistent accuracy (45\%–75\% maturity estimation error rates), high sensitivity to visual ambiguities, and poor generalizability across fruit categories. To bridge this gap, we further propose the edge fruit quality assessment framework on resource-constrained devices that integrates quantized YOLOv11 for localization with a fine-tuned quantized LVLM for efficient quality assessment. Experimental results and field deployment demonstrate that our pipeline is efficient (about 300 ms) while maintaining comprehensive and accurate fruit analysis capabilities. This work establishes a foundational benchmark for agricultural LVLM research and highlights challenges in model robustness, domain adaptation, and edge-device compatibility. We advocate for future advances in lightweight agriculture-specific LVLMs to advance precision farming. All datasets, evaluation protocols, and codes will be open-source to foster community-driven innovation and the reproducibility of our results.},
	urldate = {2026-02-21},
	journal = {Computers and Electronics in Agriculture},
	author = {Huang, Gong and Xu, Zhenbo and Liu, Liu and Chen, Jiawei and He, Zhaofeng and Liu, Fei},
	month = nov,
	year = {2025},
	keywords = {Deep learning, Edge computing, Fruit quality assessment, Large Vision Language Model, Smart agriculture systems},
	pages = {110806},
	file = {ScienceDirect Full Text PDF:/Users/admin-eranario/Zotero/storage/FZYU4WLX/Huang et al. - 2025 - Evaluating and deploying Large Vision-Language Models for fruit quality assessment in smart agricult.pdf:application/pdf;ScienceDirect Snapshot:/Users/admin-eranario/Zotero/storage/T3Z9H4CW/S0168169925009123.html:text/html},
}

@article{magistri_one_2023,
	title = {From one field to another—{Unsupervised} domain adaptation for semantic segmentation in agricultural robotics},
	volume = {212},
	issn = {0168-1699},
	url = {https://www.sciencedirect.com/science/article/pii/S0168169923005021},
	doi = {10.1016/j.compag.2023.108114},
	abstract = {In traditional arable crop fields, tractors treat the whole field uniformly applying large quantities of herbicides and pesticides for weed control and plant protection. Autonomous robots, instead, offer the potential to provide a per-plant treatment, thus turning weed control and plant protection environment-friendly. To this end, an autonomous robot has to reliably distinguish crops, weeds, and soil under a diverse range of environmental conditions using its onboard sensors. Such recognition ability forms the basis for targeted plant-specific treatments in the form of spot applications. Basically, all such perception systems used today rely on some form of machine learning technique. However, current learning-based solutions often show a performance decay when applied under new field conditions. This is a major bottleneck for real-world application and finally commercial adoption. In this paper, we propose a simple yet effective approach to unsupervised domain adaptation for semantic segmentation systems so that an existing segmentation pipeline can be adapted to different fields, different robots, and different crops. Our system yields a high segmentation performance in new target fields without the need for extra manual annotations. It exploits only annotations from the source domain, i.e., the original field used for training the robot’s vision system. Our thorough evaluation shows that our approach achieves high accuracy when transferring an existing segmentation system to different environmental conditions, different plant species, and different robotic systems.},
	urldate = {2026-02-21},
	journal = {Computers and Electronics in Agriculture},
	author = {Magistri, Federico and Weyler, Jan and Gogoll, Dario and Lottes, Philipp and Behley, Jens and Petrinic, Nik and Stachniss, Cyrill},
	month = sep,
	year = {2023},
	keywords = {Deep learning, Domain adaptation, Generative adversarial networks, Semantic segmentation},
	pages = {108114},
	file = {ScienceDirect Full Text PDF:/Users/admin-eranario/Zotero/storage/XDM2VSCP/Magistri et al. - 2023 - From one field to another—Unsupervised domain adaptation for semantic segmentation in agricultural r.pdf:application/pdf;ScienceDirect Snapshot:/Users/admin-eranario/Zotero/storage/ERWSBYKS/S0168169923005021.html:text/html},
}

