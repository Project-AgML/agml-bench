	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Artificial Intelligence},
	file = {Preprint PDF:/Users/admin-eranario/Zotero/storage/F2EFVEQC/Tschannen et al. - 2025 - SigLIP 2 Multilingual Vision-Language Encoders with Improved Semantic Understanding, Localization,.pdf:application/pdf;Snapshot:/Users/admin-eranario/Zotero/storage/JHDZKK95/2502.html:text/html},
