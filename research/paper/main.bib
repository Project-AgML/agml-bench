	file = {Preprint PDF:/Users/admin-eranario/Zotero/storage/7QL8S6IX/Bai et al. - 2023 - Qwen-VL A Versatile Vision-Language Model for Understanding, Localization, Text Reading, and Beyond.pdf:application/pdf;Snapshot:/Users/admin-eranario/Zotero/storage/URN5352P/2308.html:text/html},
